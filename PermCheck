def solution(A):
  #checks if its sum makes sense for a permutation from 1 to len (A)+1 
  thing = PermMissingElem(A)
  if  thing != len(A)+1:
    return 0
 #checks if any numbers are doubled and therefore not unique
  for i in range(len(A)):
    for j in range(i+1,len(A)):
      if A[i] == A[j]:
        return 0
  return 1
